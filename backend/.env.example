# =============================================================================
# RestaurantFlow — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
# REQUIRED in production — must be a strong, random key (50+ characters).
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-secret-django-key-change-this-in-production
# Default: False. Set to True only in development.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=restaurantflow
DB_USER=restaurantflow
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Production: include a password — redis://:your-redis-password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME=60
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# -----------------------------------------------------------------------------
# Static / Media
# -----------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Phase 7 — Kitchen / WebSocket
# -----------------------------------------------------------------------------
# Redis is already used above (REDIS_URL). No separate Redis instance needed.
# The channel layer uses REDIS_URL automatically via settings.py.

# WebSocket URL used by the React frontend to connect to the KDS.
# In development: ws://localhost:8000
# In production:  wss://yourdomain.com
VITE_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Phase 21 — Security Configuration
# -----------------------------------------------------------------------------
# Admin URL prefix (change from default 'admin' for security-by-obscurity)
ADMIN_URL_PREFIX=admin

# Login failure tracking
SECURITY_MAX_LOGIN_FAILURES=5
SECURITY_LOGIN_LOCKOUT_MINUTES=15

# Audit retention period in days (0 to disable auto-cleanup)
AUDIT_RETENTION_DAYS=365

# Rate limiting (format: count/period, e.g. "30/hour", "100/day")
THROTTLE_AUTH_LOGIN=30/hour
THROTTLE_AUTH_REGISTER=5/hour
THROTTLE_AUTH_PASSWORD=10/hour
THROTTLE_SENSITIVE_OP=60/hour
THROTTLE_EXPORT=20/hour
THROTTLE_SEARCH=120/hour

# File upload limits (bytes)
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
