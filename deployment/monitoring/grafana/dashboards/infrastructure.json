{"title": "RestaurantFlow — Infrastructure", "uid": "rf-infra", "schemaVersion": 39, "version": 1, "time": {"from": "now-1h", "to": "now"}, "refresh": "30s", "panels": [{"type": "timeseries", "title": "CPU usage (%) per core", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "100 - (avg by (cpu) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "core {{cpu}}", "refId": "A"}]}, {"type": "timeseries", "title": "Memory used / available (bytes)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "A"}, {"expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "refId": "B"}]}, {"type": "gauge", "title": "Disk usage (/)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "refId": "A"}], "fieldConfig": {"defaults": {"max": 1, "unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}}, {"type": "timeseries", "title": "Network throughput (bytes/s)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8}, "targets": [{"expr": "rate(node_network_receive_bytes_total[1m])", "legendFormat": "rx {{device}}", "refId": "A"}, {"expr": "rate(node_network_transmit_bytes_total[1m])", "legendFormat": "tx {{device}}", "refId": "B"}]}, {"type": "timeseries", "title": "Container memory by name", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "targets": [{"expr": "container_memory_usage_bytes{image!=\"\"}", "legendFormat": "{{name}}", "refId": "A"}]}]}