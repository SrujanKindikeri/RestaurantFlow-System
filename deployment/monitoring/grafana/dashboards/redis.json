{"title": "RestaurantFlow — Redis", "uid": "rf-redis", "schemaVersion": 39, "version": 1, "time": {"from": "now-1h", "to": "now"}, "refresh": "30s", "panels": [{"type": "stat", "title": "Redis up", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "redis_up", "refId": "A"}]}, {"type": "timeseries", "title": "Memory used vs max (bytes)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used", "refId": "A"}, {"expr": "redis_memory_max_bytes", "legendFormat": "max", "refId": "B"}]}, {"type": "timeseries", "title": "Connected clients", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "redis_connected_clients", "refId": "A"}]}, {"type": "timeseries", "title": "Commands / sec", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "rate(redis_commands_processed_total[1m])", "refId": "A"}]}, {"type": "timeseries", "title": "Evictions / sec", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "rate(redis_evicted_keys_total[1m])", "refId": "A"}]}, {"type": "timeseries", "title": "Key hit / miss rate", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "targets": [{"expr": "rate(redis_keyspace_hits_total[1m])", "legendFormat": "hits", "refId": "A"}, {"expr": "rate(redis_keyspace_misses_total[1m])", "legendFormat": "misses", "refId": "B"}]}]}