{"title": "RestaurantFlow — Celery", "uid": "rf-celery", "schemaVersion": 39, "version": 1, "time": {"from": "now-1h", "to": "now"}, "refresh": "30s", "panels": [{"type": "stat", "title": "Workers up", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(restaurantflow_celery_worker_up)", "refId": "A"}]}, {"type": "timeseries", "title": "Queue depth", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "restaurantflow_celery_queue_depth", "legendFormat": "{{queue}}", "refId": "A"}]}, {"type": "timeseries", "title": "Tasks started / sec", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "sum(rate(restaurantflow_celery_tasks_total[1m])) by (task)", "legendFormat": "{{task}}", "refId": "A"}]}, {"type": "timeseries", "title": "Task failures / sec", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(restaurantflow_celery_task_failures_total[1m])) by (task)", "legendFormat": "{{task}}", "refId": "A"}]}, {"type": "timeseries", "title": "Task duration p95 (s) by status", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(restaurantflow_celery_task_duration_seconds_bucket[5m])) by (le, task))", "legendFormat": "p95 {{task}}", "refId": "A"}]}]}