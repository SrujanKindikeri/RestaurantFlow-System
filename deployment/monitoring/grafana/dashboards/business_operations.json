{"title": "RestaurantFlow — Business Operations", "uid": "rf-business", "schemaVersion": 39, "version": 1, "time": {"from": "now-6h", "to": "now"}, "refresh": "30s", "panels": [{"type": "timeseries", "title": "Business events by type (/min)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(restaurantflow_business_events_total[5m])) by (event)", "legendFormat": "{{event}}", "refId": "A"}], "description": "Counter incremented from business-module failure paths via observability.record_business_event(). Covers order, kitchen, billing, payment, inventory, accounting and enterprise events."}, {"type": "stat", "title": "Payment completion failures (total)", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "sum(restaurantflow_business_events_total{event=\"payment.completion.failed\"})", "refId": "A"}]}, {"type": "stat", "title": "Bill finalization failures (total)", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8}, "targets": [{"expr": "sum(restaurantflow_business_events_total{event=\"bill.finalization.failed\"})", "refId": "A"}]}, {"type": "stat", "title": "Accounting posting failures (total)", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8}, "targets": [{"expr": "sum(restaurantflow_business_events_total{event=\"accounting.journal_posting.failed\"})", "refId": "A"}]}, {"type": "timeseries", "title": "Critical business events (/min)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14}, "targets": [{"expr": "sum(rate(restaurantflow_business_events_total{severity=\"CRITICAL\"}[5m])) by (event)", "legendFormat": "{{event}}", "refId": "A"}]}]}