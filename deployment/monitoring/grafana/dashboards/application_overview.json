{"title": "RestaurantFlow — Application Overview", "uid": "rf-app-overview", "schemaVersion": 39, "version": 1, "time": {"from": "now-1h", "to": "now"}, "refresh": "30s", "panels": [{"type": "stat", "title": "API Availability (up)", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "up{job=\"restaurantflow-api\"}", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}}, {"type": "timeseries", "title": "Request rate by route (req/s)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "sum(rate(restaurantflow_http_requests_total[5m])) by (route)", "legendFormat": "{{route}}", "refId": "A"}]}, {"type": "timeseries", "title": "p95 / p99 request latency (s)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(restaurantflow_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}", "refId": "A"}, {"expr": "histogram_quantile(0.99, sum(rate(restaurantflow_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p99 {{route}}", "refId": "B"}]}, {"type": "timeseries", "title": "Error rate (5xx/s)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(rate(restaurantflow_http_errors_total[5m])) by (route)", "legendFormat": "{{route}}", "refId": "A"}]}, {"type": "timeseries", "title": "Status class breakdown (req/s)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "targets": [{"expr": "sum(rate(restaurantflow_http_requests_total[5m])) by (status_class)", "legendFormat": "{{status_class}}", "refId": "A"}]}]}