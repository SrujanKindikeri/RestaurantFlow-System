{"title": "RestaurantFlow — PostgreSQL", "uid": "rf-postgres", "schemaVersion": 39, "version": 1, "time": {"from": "now-1h", "to": "now"}, "refresh": "30s", "panels": [{"type": "stat", "title": "PostgreSQL up", "datasource": "Prometheus", "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "pg_up", "refId": "A"}]}, {"type": "timeseries", "title": "Active connections", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "sum(pg_stat_activity_count) by (datname)", "legendFormat": "{{datname}}", "refId": "A"}]}, {"type": "gauge", "title": "Connection utilisation", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "sum(pg_stat_activity_count) / pg_settings_max_connections", "refId": "A"}], "fieldConfig": {"defaults": {"max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}}}}, {"type": "timeseries", "title": "Deadlocks (cumulative)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(pg_stat_database_deadlocks) by (datname)", "legendFormat": "{{datname}}", "refId": "A"}]}, {"type": "timeseries", "title": "Cache hit ratio", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read))", "refId": "A"}]}, {"type": "stat", "title": "Database size (bytes)", "datasource": "Prometheus", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}, "targets": [{"expr": "sum(pg_database_size_bytes)", "refId": "A"}]}]}