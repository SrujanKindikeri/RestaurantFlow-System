# =============================================================================
# RestaurantFlow — Frontend Environment Variables
# Copy this file to .env and adjust for your local setup.
# NEVER commit .env to Git.
# =============================================================================

# Backend API base URL
VITE_API_URL=http://localhost:8000/api

# Application name (used in UI)
VITE_APP_NAME=RestaurantFlow

# Phase 7 — Kitchen WebSocket URL
# In development: ws://localhost:8000
# In production:  wss://yourdomain.com  (must match the ASGI server domain)
VITE_WS_URL=ws://localhost:8000
